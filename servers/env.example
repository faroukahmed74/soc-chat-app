# =============================================================================
# SOC Chat App - Environment Configuration Example
# =============================================================================
# Copy this file to servers/local_api_server/.env and update the values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB connection string with authentication
MONGO_URI=mongodb://admin:SecurePassword123!@localhost:27017/soc_chat_app?authSource=admin

# JWT secret key for token signing (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your_secure_jwt_secret_key_change_this_in_production_minimum_32_characters

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Server port (default: 3003)
PORT=3003

# Server host (use 0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Node environment (development, production, test)
NODE_ENV=production

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins for CORS (comma-separated)
# Include your ngrok URL, local development URLs, and production domain
ALLOWED_ORIGINS=http://localhost:8080,http://192.168.0.117:8080,https://your-ngrok-url.ngrok.app

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
# Maximum file upload size in MB
MAX_UPLOAD_MB=50

# Public base URL for file access (leave empty for auto-detection)
PUBLIC_BASE_URL=

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Rate limiting window in milliseconds (15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window per IP
RATE_LIMIT_MAX_REQUESTS=200

# =============================================================================
# CLOUDFLARE ACCESS (OPTIONAL)
# =============================================================================
# Cloudflare Access configuration for admin routes
CF_ACCESS_CERTS_URL=
CF_ACCESS_AUD=
CF_ACCESS_REQUIRED=false

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================
# FCM server URL for notifications
FCM_SERVER_URL=http://localhost:3000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Enable debug mode (only for development)
DEBUG=false

# Enable detailed error messages (disable in production)
DETAILED_ERRORS=false

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================
# SSL certificate paths (for HTTPS in production)
SSL_CERT_PATH=
SSL_KEY_PATH=

# Trust proxy (set to true if behind a reverse proxy)
TRUST_PROXY=false

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup directory path
BACKUP_DIR=/backup

# Enable automatic backups
AUTO_BACKUP=true

# Backup frequency in hours
BACKUP_FREQUENCY_HOURS=24

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Health check endpoint
HEALTH_CHECK_ENABLED=true

# Metrics collection
METRICS_ENABLED=true

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit the actual .env file to version control
# 2. Use strong, unique passwords and secrets in production
# 3. Update ALLOWED_ORIGINS to include your production domain
# 4. Set NODE_ENV=production for production deployments
# 5. Use HTTPS in production and update SSL configuration
# 6. Regularly rotate JWT secrets and database passwords
# 7. Monitor logs and set up proper alerting
