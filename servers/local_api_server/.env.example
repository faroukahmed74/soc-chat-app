HOST=0.0.0.0
PORT=3000
# Comma-separated list of allowed origins (include ngrok for mobile, proxy ports for web)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8082,https://soc-chat-app.ngrok-free.app

# Local MongoDB (do not expose publicly)
MONGO_URI=mongodb://admin:SecurePassword123!@localhost:27017/soc_chat_app?authSource=admin

# Change this in production
JWT_SECRET=please_change_this_secret

# Cloudflare Access settings (protect admin routes when deployed behind Cloudflare)
# Set CF_ACCESS_REQUIRED=true in production and configure certs URL and audience tag
CF_ACCESS_REQUIRED=false
CF_ACCESS_CERTS_URL=https://YOUR_TEAM_NAME.cloudflareaccess.com/cdn-cgi/access/certs
CF_ACCESS_AUD=YOUR_APPLICATION_AUD_TAG